{
  "functions": {
    "api/indicators.js": { "maxDuration": 10 },
    "api/stock-profile.js": { "maxDuration": 15 },
    "api/brokerHolding.js": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/market-status", "destination": "/api/market-status" },

    { "source": "/api/core/live-nepse",       "destination": "/api/core?route=live-nepse" },
    { "source": "/api/core/market-turnover",  "destination": "/api/core?route=market-turnover" },
    { "source": "/api/core/index-live",       "destination": "/api/core?route=index-live" },
    { "source": "/api/core/subindex-live",    "destination": "/api/core?route=subindex-live" },
    { "source": "/api/core/homepage-data",    "destination": "/api/core?route=homepage-data" },
    { "source": "/api/core/floorsheet/totals","destination": "/api/core?route=floorsheet-totals" },
    { "source": "/api/core/floorsheet",       "destination": "/api/core?route=floorsheet" },

    { "source": "/charts/stock-chart/index/1D/:symbol", "destination": "/api/charts?route=index-chart&symbol=:symbol" },
    { "source": "/charts/stock-chart/:symbol",           "destination": "/api/charts?route=stock-chart&symbol=:symbol" },
    { "source": "/api/charts/stock-chart",   "destination": "/api/charts?route=stock-chart" },
    { "source": "/api/charts/index-chart",   "destination": "/api/charts?route=index-chart" },

    { "source": "/market-info/announcements",          "destination": "/api/market-info?route=announcements" },
    { "source": "/market-info/ipo/general",            "destination": "/api/market-info?route=offering&type=0&for=2" },
    { "source": "/market-info/ipo/local",              "destination": "/api/market-info?route=offering&type=0&for=0" },
    { "source": "/market-info/ipo/foreign",            "destination": "/api/market-info?route=offering&type=0&for=1" },
    { "source": "/market-info/right-share",            "destination": "/api/market-info?route=offering&type=2&for=2" },
    { "source": "/market-info/fpo",                    "destination": "/api/market-info?route=offering&type=1&for=2" },
    { "source": "/market-info/mutual-fund-offering",   "destination": "/api/market-info?route=offering&type=3&for=2" },
    { "source": "/market-info/debenture-offering",     "destination": "/api/market-info?route=offering&type=4&for=2" },
    { "source": "/api/market-info/announcements",      "destination": "/api/market-info?route=announcements" },
    { "source": "/api/market-info/offering",           "destination": "/api/market-info?route=offering" },

    { "source": "/stock-profile/alpha-beta",        "destination": "/api/stock-profile?route=alpha-beta" },
    { "source": "/stock-profile/broker-top-holding","destination": "/api/stock-profile?route=broker-top-holding" },
    { "source": "/stock-profile/broker-snapshot",   "destination": "/api/stock-profile?route=broker-snapshot" },
    { "source": "/stock-profile/market-depth/:symbol","destination": "/api/stock-profile?route=market-depth&symbol=:symbol" },
    { "source": "/stock-profile/market-depth",      "destination": "/api/stock-profile?route=market-depth" },
    { "source": "/stock-profile/report",            "destination": "/api/stock-profile?route=report" },
    { "source": "/stock-profile",                   "destination": "/api/stock-profile?route=profile" },
    { "source": "/api/stock-profile/alpha-beta",        "destination": "/api/stock-profile?route=alpha-beta" },
    { "source": "/api/stock-profile/broker-top-holding","destination": "/api/stock-profile?route=broker-top-holding" },
    { "source": "/api/stock-profile/broker-snapshot",   "destination": "/api/stock-profile?route=broker-snapshot" },
    { "source": "/api/stock-profile/market-depth",      "destination": "/api/stock-profile?route=market-depth" },
    { "source": "/api/stock-profile/report",            "destination": "/api/stock-profile?route=report" },

    { "source": "/api/indicators/rsi",        "destination": "/api/indicators?route=rsi" },
    { "source": "/api/indicators/macd",       "destination": "/api/indicators?route=macd" },
    { "source": "/api/indicators/crossover",  "destination": "/api/indicators?route=crossover" },
    { "source": "/api/indicators/volume",     "destination": "/api/indicators?route=volume" },
    { "source": "/api/indicators/ad_vwap",    "destination": "/api/indicators?route=ad_vwap" },
    { "source": "/api/indicators",            "destination": "/api/indicators" },

    { "source": "/api/broker-holding",        "destination": "/api/brokerHolding" },

    { "source": "/(.*)", "destination": "/api/$1" }
  ]
}